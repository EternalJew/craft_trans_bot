# Telegram Bot
TELEGRAM_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username   # without @, shown as a link on the landing page

# Backend API
DATABASE_URL=sqlite:///./data.db
SECRET_KEY=change-me-in-production-please-use-random-string
BOT_API_KEY=bot-secret-key

# Backend base URL (used by bot)
API_BASE=http://localhost:8000

# Whoever keeps the paper book — gets a "write this in the book" message for
# every booking, from any channel. Comma-separated Telegram ids (@userinfobot).
OWNER_TELEGRAM_IDS=

# Notifications
REMINDER_HOUR=10          # local hour the day-before reminders are queued
TZ=Europe/Kyiv
NOTIFY_POLL_SECONDS=20    # how often the bot drains the notification outbox

# Public HTTPS origin serving the backend — required for the driver Mini App
# (Telegram only opens web apps over HTTPS).
# ./tunnel.sh rewrites this with the ngrok URL each time it opens a tunnel.
WEBAPP_URL=https://your-domain.example

# Public tunnel (optional). Token: https://dashboard.ngrok.com/get-started/your-authtoken
# Used only by the "tunnel" compose profile: docker compose --profile tunnel up -d ngrok
NGROK_AUTHTOKEN=

# First admin account (used by seed.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Parcels: where senders ship them and when we collect
# Shown on the landing and dictated by the bot, so a sender can fill in the
# Nova Poshta form without calling. The office alone is not enough — Nova
# Poshta will not accept a parcel without a named recipient.
PARCEL_NP_OFFICE=Область, місто, відділення №N
PARCEL_NP_RECIPIENT=Прізвище Ім'я
PARCEL_NP_RECIPIENT_PHONE=0XXXXXXXXX
# Days we collect from that office, 0=Mon. Leave empty and we promise no
# deadline — the copy names the next departure instead of guessing.
PARCEL_NP_WEEKDAYS=
# Where a sender may bring a parcel by hand. Empty falls back to "to us in Rivne".
PARCEL_DROPOFF=
